[Unit]
Description=MotoCare ASP.NET Core API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/home/MotoCare/current/api
ExecStart=/home/MotoCare/current/api/MotoCare.Api
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://127.0.0.1:5112
Environment=DataProtection__KeysPath=/home/MotoCare/shared/data-protection-keys
EnvironmentFile=-/home/MotoCare/shared/motocare.env
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT
SyslogIdentifier=motocare-api
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
UMask=0027

[Install]
WantedBy=multi-user.target
